<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Permissão "normal": concedida na instalação, sem diálogo. Fundida no manifesto do app. -->
  <uses-permission android:name="android.permission.NFC" />

  <!-- Feedback tátil no sucesso da leitura (E6-H2). Permissão normal. -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!--
    Não obrigatória: o SDK não esconde o app do integrador na Play Store para quem
    não tem NFC. A ausência é tratada em tempo de execução (RN-01 → NFC_UNSUPPORTED).
  -->
  <uses-feature android:name="android.hardware.nfc" android:required="false" />

</manifest>
